<?xml version="1.0" encoding="utf-8"?>
<!-- The icon's glyph, "contact in a loop": a person inside two chasing sync arrows. Drawn in the 72-unit square an
     adaptive icon shows, inset 18 on its 108-unit canvas, and inside the 66-unit safe zone. The launcher's foreground
     and monochrome layers, and the app's mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="18"
        android:translateY="18">
        <!-- The two arrows, each an arc with its head, one turned half a circle from the other. -->
        <path
            android:pathData="M19.1,42.2 A18,18 0 0,1 49.8,24.4 M49.5,18.2 L49.8,24.4 L43.7,23"
            android:strokeColor="@color/icon_glyph"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="4" />
        <path
            android:pathData="M52.9,29.8 A18,18 0 0,1 22.2,47.6 M22.5,53.8 L22.2,47.6 L28.3,49"
            android:strokeColor="@color/icon_glyph"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="4" />
        <!-- The person: a head and shoulders. -->
        <path
            android:fillColor="@color/icon_glyph"
            android:pathData="M31.5,31.5 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z M27.5,45 a8.5,7.5 0 0,1 17,0 Z" />
    </group>
</vector>
