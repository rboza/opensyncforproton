<?xml version="1.0" encoding="utf-8"?>
<!-- With an edit schema, the Contacts app edits synced contacts in place. It lists exactly docs/mapping.md § Field
     table's data kinds, with only the types that table carries both ways. If the Contacts app's parser (GrapheneOS
     platform_packages_apps_Contacts 5db1ee1) rejects it, that app edits the account's contacts with a generic schema of
     every kind and type instead, so: name must support every part, photo must be listed, name, nickname, organization,
     photo, note, and sip_address allow one each, and a typed kind needs at least one type. -->
<ContactsAccountType>
    <EditSchema>
        <DataKind
            kind="name"
            maxOccurs="1"
            supportsPrefix="true"
            supportsMiddleName="true"
            supportsSuffix="true"
            supportsPhoneticFamilyName="true"
            supportsPhoneticMiddleName="true"
            supportsPhoneticGivenName="true" />
        <DataKind kind="photo" maxOccurs="1" />
        <DataKind kind="phone">
            <Type type="home" />
            <Type type="mobile" />
            <Type type="work" />
            <Type type="fax_work" />
            <Type type="fax_home" />
            <Type type="pager" />
            <Type type="other" />
            <Type type="main" />
            <Type type="custom" />
        </DataKind>
        <DataKind kind="email">
            <Type type="home" />
            <Type type="work" />
            <Type type="other" />
            <Type type="custom" />
        </DataKind>
        <!-- Structured, as the app writes it; the editor shows street, city, region, postcode, and country. -->
        <DataKind kind="postal" needsStructured="true">
            <Type type="home" />
            <Type type="work" />
            <Type type="other" />
        </DataKind>
        <DataKind kind="organization" maxOccurs="1" />
        <!-- docs/mapping.md § Field table: the first BDAY and the first ANNIVERSARY with a month and day are read; any
             date may lack its year. -->
        <DataKind kind="event">
            <Type type="birthday" maxOccurs="1" yearOptional="true" />
            <Type type="anniversary" maxOccurs="1" yearOptional="true" />
            <Type type="other" yearOptional="true" />
            <Type type="custom" yearOptional="true" />
        </DataKind>
        <DataKind kind="note" maxOccurs="1" />
        <DataKind kind="website" />
        <DataKind kind="nickname" maxOccurs="1" />
        <DataKind kind="relationship">
            <Type type="assistant" />
            <Type type="brother" />
            <Type type="child" />
            <Type type="domestic_partner" />
            <Type type="father" />
            <Type type="friend" />
            <Type type="manager" />
            <Type type="mother" />
            <Type type="parent" />
            <Type type="partner" />
            <Type type="referred_by" />
            <Type type="relative" />
            <Type type="sister" />
            <Type type="spouse" />
            <Type type="custom" />
        </DataKind>
        <DataKind kind="sip_address" maxOccurs="1" />
    </EditSchema>
</ContactsAccountType>
